# Directorios de trabajo
DATA_DIR=./data/raw
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports

# Catastro local de concesiones y permisos de extracción de áridos (GeoPackage / GeoJSON)
PERMITS_GPKG_PATH=./data/permits.gpkg

# Configuración de red y endpoints externos
HTTP_TIMEOUT_SECONDS=25.0
IGN_WFS_URL=https://wms.ign.gob.ar/geoserver/ows
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Proveedores ópticos / multiespectrales STAC y XYZ
OPTICAL_PROVIDER=sentinel2_stac
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
PLANETARY_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
XYZ_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Filtros y umbrales multitemporales / catastrales
MAX_CLOUD_COVER_PCT=20.0
SEASONAL_WINDOW_DAYS=45
MIN_VALID_PIXEL_FRACTION=0.70
BASELINE_MAX_SCENES=3
MAX_MASTER_SIDE_PX=4096
MAX_OPTICAL_CHIP_PX=512
OPTICAL_BUFFER_M=200.0
MIN_ANOMALY_AREA_M2=1600.0
EXCESS_TOLERANCE_PCT=5.0

# Backend opcional para Juez Multimodal VLM (Gemini)
# GEMINI_API_KEY=
# GEMINI_VLM_MODEL=gemini-2.5-flash
